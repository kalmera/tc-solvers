opam-version: "2.0"
synopsis: "Extracted total-correctness solvers for side-effecting constraints"
maintainer: "Kalmer Apinis"
authors: ["Kalmer Apinis" "SLR-TC contributors"]
license: ["MIT" "LGPL-2.1-only"]
homepage: "https://github.com/kalmera/tc-solvers"
bug-reports: "https://github.com/kalmera/tc-solvers/issues"
dev-repo: "git+https://github.com/kalmera/tc-solvers.git"
depends: [
  "ocaml" {>= "5.4.0" & < "5.5"}
  "dune" {>= "3.19"}
  "batteries" {with-test}
  "yojson" {with-test}
]
build: [["dune" "build" "-p" name "-j" jobs]]
run-test: [["dune" "runtest" "-p" name "-j" jobs]]
